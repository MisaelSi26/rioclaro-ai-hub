NODE_ENV=development
PORT=3000
DEV_AUTH_ENABLED=true
SESSION_KEYS=replace-with-a-random-secret-at-least-32-characters
APP_BASE_URL=http://localhost:5173/

# Microsoft Entra ID app registration
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback

# Azure SQL Database
SQL_CONNECTION_STRING=

# Azure Blob Storage (optional for invoice document retention)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=invoices

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Azure AI Search + Azure OpenAI (RAG)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=rio-claro-index
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Speech Services
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus3
